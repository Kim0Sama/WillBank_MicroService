# Configuration des variables d'environnement pour WillBank Microservices
# Copier ce fichier en .env et ajuster les valeurs selon votre environnement

# ===== Base de données MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=willbank_db
DB_USERNAME=willbank_user
DB_PASSWORD=WillBank2024!

# ===== Eureka Server =====
EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_URL=http://localhost:8761/eureka/

# ===== Client Service =====
CLIENT_SERVICE_PORT=8081
CLIENT_SERVICE_NAME=client-service

# ===== Account Service =====
ACCOUNT_SERVICE_PORT=8082
ACCOUNT_SERVICE_NAME=account-service

# ===== Transaction Service =====
TRANSACTION_SERVICE_PORT=8083
TRANSACTION_SERVICE_NAME=transaction-service

# ===== Notification Service =====
NOTIFICATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_NAME=notification-service

# ===== Email Configuration (pour Notification Service) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@willbank.com

# ===== SMS Configuration (pour Notification Service) =====
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.com/send

# ===== Logging =====
LOG_LEVEL=INFO
LOG_PATH=./logs

# ===== Profil Spring actif =====
# Options: default (H2), mysql (MySQL)
SPRING_PROFILES_ACTIVE=default

# ===== JWT Configuration (pour future implémentation) =====
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=86400000

# ===== Actuator =====
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
